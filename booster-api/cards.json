    { "id": "legendaire",  "label": "Légendaire",  "weight": 1,  "color": "#a855f7", "finish": "foil" }
  ],

  // Tes cartes. "id" ne doit JAMAIS changer une fois en ligne (c'est ce qui est stocké dans les collections).

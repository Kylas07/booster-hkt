  // La dernière carte de chaque booster est au moins de cette rareté
  "guaranteedMinRarity": "peu-commune",

  // Du plus commun au plus rare. "weight" = poids relatif (70 + 22 + 7 + 1 = 100, donc ici ce sont des %)
  // "finish" = effet de la carte : "normal", "argent", "or" ou "foil" (holographique)
